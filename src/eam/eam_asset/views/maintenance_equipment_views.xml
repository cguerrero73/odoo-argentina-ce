<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_view_form_asset_code" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.asset.code</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='service_info_group']//field[@name='company_id']" position="before">
                <field name="asset_code" readonly="id" placeholder="e.g. EAM/000001"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_view_tree_asset_code" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.asset.code</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="asset_code"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_view_search_asset_code" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.asset.code</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[
                    '|', '|', '|', '|',
                    ('name', 'ilike', self),
                    ('asset_code', 'ilike', self),
                    ('model', 'ilike', self),
                    ('serial_no', 'ilike', self),
                    ('partner_ref', 'ilike', self)
                ]</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="asset_code" string="Equipment Code"/>
            </xpath>
        </field>
    </record>
</odoo>
